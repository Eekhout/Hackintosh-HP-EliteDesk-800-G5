<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.hackintosh.mbuf-guardian</string>
	<key>ProgramArguments</key>
	<array>
		<string>/bin/bash</string>
		<string>/usr/local/bin/mbuf_watchdog_guardian.sh</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<key>StandardOutPath</key>
	<string>/var/log/mbuf_guardian.log</string>
	<key>StandardErrorPath</key>
	<string>/var/log/mbuf_guardian_err.log</string>
	<key>ThrottleInterval</key>
	<integer>10</integer>
</dict>
</plist>
